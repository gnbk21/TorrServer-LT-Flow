# Preserve portable build scripts and identical embedded text across hosts.
*.go text eol=lf
*.sh text eol=lf
*.py text eol=lf
build/native-patches/*.patch text eol=lf -whitespace
build/just-player/*.patch text eol=lf -whitespace
.github/** text eol=lf
distribution/** text eol=lf
web/** text=auto eol=lf
server/web/pages/template/** text=auto eol=lf

# Preserve upstream schema bytes and their pinned SHA-256 hashes on Windows.
build/schema/cyclonedx-1.6/*.json -text
build/schema/cyclonedx-1.6/LICENSE -text
