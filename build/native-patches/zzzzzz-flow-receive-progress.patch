+// Partial completion is not evidence of current progress. A block that has
+// stopped receiving may use the existing bounded hedge path, even past 75%.
+// Protect real recent payload for a service-relative grace; never treat an
+// unknown or future timestamp as fresh progress.
+inline bool flow_receiving_recent(int received, int length,
+	std::int64_t idle_ms, std::int64_t threshold_ms)
+{
+	return received>0 && length>0 && received<=length && idle_ms>=0
+		&& threshold_ms>0 && idle_ms<std::max<std::int64_t>(250,threshold_ms/2);
+}
 inline flow_recovery_result flow_recovery_check(bool uncertain, bool fresh,
 	int owners, std::int64_t age, std::int64_t threshold, bool receiving)
 {
