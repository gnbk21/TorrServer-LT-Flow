 // Flow's bounded service model and duplicate-credit ownership.
 // All policy clocks are monotonic milliseconds supplied by the network executor.
 #pragma once
-#define TORRENT_FLOW_STREAM_CONTROL 3
+#define TORRENT_FLOW_STREAM_CONTROL 4
 #include <algorithm>
 #include <array>
 #include <atomic>
@@ -84,8 +84,14 @@
 		// An underfilled pipeline underestimates the peer's bandwidth. Permit
 		// its bounded, measured credit to grow before applying the drain-time
 		// cutoff; otherwise a high-latency peer can remain stuck at two blocks.
-		return queue_ms <= urgent_horizon_ms(enabled,now)
-			|| (enabled && fresh(now) && mean_ms<=horizon_ms() && queued < desired);
+		auto const horizon=urgent_horizon_ms(enabled,now);
+		// An underfilled slot count can outlive a rate drop. Preserve a small
+		// bootstrap allowance beyond the horizon, but never let that exception
+		// feed an arbitrarily long remote queue. Existing requests drain without
+		// cancellation; other peers remain eligible independently.
+		return queue_ms <= horizon
+			|| (enabled && fresh(now) && mean_ms<=horizon_ms()
+				&& queue_ms<=2*horizon && queued < desired);
 	}
 	std::int64_t late_after_ms() const {
 		return std::clamp<std::int64_t>(mean_ms+std::max<std::int64_t>(100,4*deviation_ms),250,15000);
