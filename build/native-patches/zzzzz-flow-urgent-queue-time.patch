+
+
+TORRENT_TEST(flow_urgent_bootstrap_allowance_has_a_time_bound)
+{
+    using namespace lt::aux;
+    flow_service_model delayed;
+    for(int i=0;i<32;++i) delayed.observe(2500,1000+i*100);
+    auto const horizon=delayed.urgent_horizon_ms(true,4200);
+    TEST_CHECK(delayed.urgent_work_allowed(4000,2,4,true,4200));
+    TEST_CHECK(delayed.urgent_work_allowed(2*horizon,2,4,true,4200));
+    TEST_CHECK(!delayed.urgent_work_allowed(2*horizon+1,2,4,true,4200));
+    TEST_CHECK(!delayed.urgent_work_allowed(25000,100,428,true,4200));
+    TEST_CHECK(!delayed.urgent_work_allowed(4000,4,4,true,4200));
+    TEST_CHECK(!delayed.urgent_work_allowed(4000,2,4,false,4200));
+    TEST_CHECK(!delayed.urgent_work_allowed(4000,2,4,true,30000));
+    flow_service_model fast;
+    for(int i=0;i<32;++i) fast.observe(100,1000+i*100);
+    TEST_CHECK(fast.urgent_work_allowed(500,1,8,true,4200));
+    TEST_CHECK(fast.urgent_work_allowed(0,0,8,true,4200));
+}
