+TORRENT_TEST(flow_stream_high_latency_and_request_capacity)
+{
+	using namespace lt::aux;
+	flow_service_model slow, fast;
+	for(int i=0;i<32;++i) {
+		slow.observe(4000,1000+i*100);
+		fast.observe(50,1000+i*100);
+	}
+	TEST_CHECK(slow.horizon_ms()>2000 && slow.horizon_ms()<=6000);
+	TEST_CHECK(slow.late_after_ms()>=4000);
+	TEST_EQUAL(fast.horizon_ms(),250);
+	TEST_CHECK(slow.urgent_horizon_ms(true,4200)>2000);
+	TEST_EQUAL(slow.urgent_horizon_ms(false,4200),2000);
+	TEST_EQUAL(slow.urgent_horizon_ms(true,20000),2000);
+	TEST_EQUAL(slow.urgent_horizon_ms(true,0),2000);
+	TEST_EQUAL(fast.urgent_horizon_ms(true,4200),2000);
+	flow_service_model untrained;
+	untrained.observe(4000,4200);
+	TEST_EQUAL(untrained.urgent_horizon_ms(true,4200),2000);
+	int credit=128;
+	for(int i=0;i<4;++i) credit=slow.credit(credit,1024*1024,16384,512,1500,4200+i*500);
+	TEST_CHECK(credit>128 && credit<=512);
+	TEST_EQUAL(slow.credit(credit,1024*1024,16384,1,1500,6200),1);
+	TEST_EQUAL(slow.credit(credit,1024*1024,16384,512,32,6200),32);
+	TEST_EQUAL(slow.credit(credit,1024*1024,16384,512,1500,20000),credit);
+	for(int i=0;i<32;++i) slow.observe(299999,30000+i*100);
+	TEST_EQUAL(slow.horizon_ms(),6000);
+	TEST_EQUAL(slow.late_after_ms(),15000);
+}
+
+TORRENT_TEST(flow_stream_recovery_is_independent_per_block)
+{
+	using namespace lt::aux;
+	using result=flow_recovery_result;
+	TEST_CHECK(flow_recovery_check(true,true,1,5000,2000,false)==result::uncertain_request);
+	// Another request in the same frontier remains eligible.
+	TEST_CHECK(flow_recovery_check(false,true,1,5000,2000,false)==result::eligible);
+	TEST_CHECK(flow_recovery_check(false,false,1,5000,2000,false)==result::stale_service);
+	TEST_CHECK(flow_recovery_check(false,true,2,5000,2000,false)==result::already_duplicated);
+	TEST_CHECK(flow_recovery_check(false,true,1,1000,2000,false)==result::not_late);
+	TEST_CHECK(flow_recovery_check(false,true,1,5000,2000,true)==result::receiving);
+	TEST_CHECK(flow_recovery_check(false,true,1,-1,2000,false)==result::uncertain_request);
+}
+
+// A measured high-latency peer must escape the stock two-block startup
+// equilibrium without bypassing remote/local capacity or stale-model fallback.
+TORRENT_TEST(flow_high_latency_pipeline_bootstrap)
+{
+    libtorrent::aux::flow_service_model model;
+    for (int i=0;i<16;++i) model.observe(2500,3000+i*10);
+    TEST_CHECK(model.fresh(3200));
+    int credit=model.credit(2,12000,16384,512,512,3200);
+    TEST_EQUAL(credit,3);
+    TEST_EQUAL(model.credit(16,95000,16384,512,512,3800),17);
+    TEST_CHECK(model.urgent_work_allowed(4000,2,credit,true,3200));
+    TEST_CHECK(!model.urgent_work_allowed(4000,credit,credit,true,3200));
+    TEST_CHECK(!model.urgent_work_allowed(4000,2,credit,false,3200));
+    TEST_CHECK(!model.urgent_work_allowed(4000,2,credit,true,20000));
+    TEST_CHECK(!model.urgent_work_allowed(4000,2,credit,true,0));
+    TEST_EQUAL(model.credit(2,12000,16384,1,512,3800),1);
+}
+
+TORRENT_TEST(flow_high_latency_probes_are_full_paced_and_capped)
+{
+    libtorrent::aux::flow_service_model model;
+    for (int i=0;i<16;++i) model.observe(2500,3000+i*10);
+    TEST_EQUAL(model.credit(2,12000,16384,512,512,3200,2),4);
+    TEST_EQUAL(model.credit(4,12000,16384,512,512,3300,4),4);
+    TEST_EQUAL(model.credit(16,95000,16384,512,512,3800,16),20);
+    TEST_EQUAL(model.credit(16,95000,16384,512,18,4400,16),18);
+    TEST_EQUAL(model.credit(16,95000,16384,1,512,5000,16),1);
+    // An empty pipeline cannot probe beyond its bandwidth-derived target.
+    TEST_EQUAL(model.credit(16,95000,16384,512,512,5600,0),17);
+    TEST_EQUAL(model.credit(16,95000,16384,512,512,20000,16),16);
+    for (int i=0;i<16;++i) model.observe(i%2?500:5000,21000+i*10);
+    TEST_CHECK(4*model.deviation_ms>model.mean_ms);
+    int const before=16;
+    int const target=int(95000*model.horizon_ms()/1000/16384+2);
+    int const next=model.credit(before,95000,16384,512,512,22000,16);
+    TEST_CHECK(next<=std::max(before,target));
+}
+
+TORRENT_TEST(flow_high_latency_application_limited_transition_retains_credit)
+{
+    libtorrent::aux::flow_service_model model;
+    for (int i=0;i<32;++i) model.observe(2500,1000+i*100);
+    // Preload can leave a trained window underfilled until a reader opens.
+    // A low application-limited rate must not erase its useful window.
+    TEST_EQUAL(model.credit(428,12000,16384,512,512,4200,284),428);
+    TEST_EQUAL(model.credit(428,12000,16384,512,512,4800,0),428);
+    TEST_EQUAL(model.credit(428,12000,16384,512,512,5400,428),512);
+    TEST_EQUAL(model.credit(428,12000,16384,32,512,6000,0),32);
+    // A changed/jittery service path may reduce the window normally.
+    for (int i=0;i<16;++i) model.observe(i%2?500:5000,6100+i*100);
+    TEST_CHECK(4*model.deviation_ms>model.mean_ms);
+    TEST_CHECK(model.credit(428,12000,16384,512,512,8000,0)<428);
+    TEST_CHECK(!model.fresh(30000));
+}
