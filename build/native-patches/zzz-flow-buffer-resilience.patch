+TORRENT_TEST(flow_stream_high_latency_and_request_capacity)
+{
+	using namespace lt::aux;
+	flow_service_model slow, fast;
+	for(int i=0;i<32;++i) {
+		slow.observe(4000,1000+i*100);
+		fast.observe(50,1000+i*100);
+	}
+	TEST_CHECK(slow.horizon_ms()>2000 && slow.horizon_ms()<=6000);
+	TEST_CHECK(slow.late_after_ms()>=4000);
+	TEST_EQUAL(fast.horizon_ms(),250);
+	TEST_CHECK(slow.urgent_horizon_ms(true,4200)>2000);
+	TEST_EQUAL(slow.urgent_horizon_ms(false,4200),2000);
+	TEST_EQUAL(slow.urgent_horizon_ms(true,20000),2000);
+	TEST_EQUAL(slow.urgent_horizon_ms(true,0),2000);
+	TEST_EQUAL(fast.urgent_horizon_ms(true,4200),2000);
+	flow_service_model untrained;
+	untrained.observe(4000,4200);
+	TEST_EQUAL(untrained.urgent_horizon_ms(true,4200),2000);
+	int credit=128;
+	for(int i=0;i<4;++i) credit=slow.credit(credit,1024*1024,16384,512,1500,4200+i*500);
+	TEST_CHECK(credit>128 && credit<=512);
+	TEST_EQUAL(slow.credit(credit,1024*1024,16384,1,1500,6200),1);
+	TEST_EQUAL(slow.credit(credit,1024*1024,16384,512,32,6200),32);
+	TEST_EQUAL(slow.credit(credit,1024*1024,16384,512,1500,20000),credit);
+	for(int i=0;i<32;++i) slow.observe(299999,30000+i*100);
+	TEST_EQUAL(slow.horizon_ms(),6000);
+	TEST_EQUAL(slow.late_after_ms(),15000);
+}
+
+TORRENT_TEST(flow_stream_recovery_is_independent_per_block)
+{
+	using namespace lt::aux;
+	using result=flow_recovery_result;
+	TEST_CHECK(flow_recovery_check(true,true,1,5000,2000,false)==result::uncertain_request);
+	// Another request in the same frontier remains eligible.
+	TEST_CHECK(flow_recovery_check(false,true,1,5000,2000,false)==result::eligible);
+	TEST_CHECK(flow_recovery_check(false,false,1,5000,2000,false)==result::stale_service);
+	TEST_CHECK(flow_recovery_check(false,true,2,5000,2000,false)==result::already_duplicated);
+	TEST_CHECK(flow_recovery_check(false,true,1,1000,2000,false)==result::not_late);
+	TEST_CHECK(flow_recovery_check(false,true,1,5000,2000,true)==result::receiving);
+	TEST_CHECK(flow_recovery_check(false,true,1,-1,2000,false)==result::uncertain_request);
+}
