+inline flow_recovery_result flow_recovery_check(bool uncertain, bool fresh,
+	int owners, std::int64_t age, std::int64_t threshold, bool receiving)
+{
+	if (uncertain || age < 0) return flow_recovery_result::uncertain_request;
+	if (!fresh) return flow_recovery_result::stale_service;
+	if (owners != 1) return flow_recovery_result::already_duplicated;
+	if (age < threshold) return flow_recovery_result::not_late;
+	if (receiving) return flow_recovery_result::receiving;
+	return flow_recovery_result::eligible;
