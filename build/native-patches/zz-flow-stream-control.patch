+	bool torrent::flow_recovery_ready(piece_index_t const piece) const
+	{
+		auto const found=std::find(m_flow_frontiers.begin(),m_flow_frontiers.end(),int(piece));
+		if(found==m_flow_frontiers.end() || !m_flow_qualified[std::size_t(found-m_flow_frontiers.begin())]) return false;
+		return std::any_of(m_flow_late_blocks.begin(),m_flow_late_blocks.end(),
+			[piece](piece_block const& block){return block.piece_index==piece;});
+	}
