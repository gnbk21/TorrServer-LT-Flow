+	std::array<std::uint64_t, 8> buckets{};
+	std::uint64_t samples = 0;
+	void add(std::int64_t ms) {
+		if (ms < 0 || ms > 300000) return;
+		constexpr std::array<int, 8> bounds{{25,100,250,500,1000,2000,5000,300000}};
+		for (std::size_t i=0; i<bounds.size(); ++i)
+			if (ms <= bounds[i]) { ++buckets[i]; ++samples; break; }
+	}
+	int percentile(int percent) const {
+		if (!samples) return 0;
+		constexpr std::array<int,8> bounds{{25,100,250,500,1000,2000,5000,300000}};
+		auto const target = samples/100*percent + (samples%100*percent+99)/100;
+		std::uint64_t total=0;
+		for (std::size_t i=0;i<bounds.size();++i)
+			if ((total+=buckets[i]) >= target) return bounds[i];
+		return bounds.back();
+	}
+};
+
+// Conservative bounded filter for non-FAST cancelled block identities. False
+// positives only discard observations; old replies cannot masquerade as a new
+// request's service sample. State dies with the connection.
+struct flow_cancel_filter {
+	std::array<std::uint64_t,64> bits{};
+	static std::uint64_t key(int piece,int block) {
+		auto x=std::uint64_t(std::uint32_t(piece))*0x9e3779b97f4a7c15ULL+std::uint32_t(block);
+		x^=x>>30; x*=0xbf58476d1ce4e5b9ULL; x^=x>>27; return x;
+	}
+	void add(int piece,int block) {
+		auto const x=key(piece,block);
+		for(int i=0;i<3;++i) { auto const b=(x>>(i*12))&4095; bits[b/64]|=std::uint64_t(1)<<(b%64); }
+	}
+	bool contains(int piece,int block) const {
+		auto const x=key(piece,block);
+		for(int i=0;i<3;++i) { auto const b=(x>>(i*12))&4095; if(!(bits[b/64]&(std::uint64_t(1)<<(b%64)))) return false; }
+		return true;
+	}
+};
+
+struct flow_service_model {
+	flow_histogram histogram;
+	std::int64_t mean_ms=0, deviation_ms=0, last_ms=-1, adjusted_ms=-1;
+	std::uint64_t budget_changes=0;
+	void observe(std::int64_t delay, std::int64_t now) {
+		if (delay<0 || delay>300000) return;
+		histogram.add(delay);
+		if (last_ms<0 || now<last_ms || now-last_ms>10000) {
+			mean_ms=delay; deviation_ms=delay/2;
+			fresh_samples=0;
+		} else {
+			auto const difference=mean_ms>delay ? mean_ms-delay : delay-mean_ms;
+			deviation_ms=(3*deviation_ms+difference)/4;
+			mean_ms=(7*mean_ms+delay)/8;
+		}
+		++fresh_samples; last_ms=now;
+	}
+	bool fresh(std::int64_t now) const {
+		return fresh_samples>=8 && last_ms>=0 && now>=last_ms && now-last_ms<=10000;
+	}
+	std::int64_t late_after_ms() const {
+		return std::clamp<std::int64_t>(mean_ms+std::max<std::int64_t>(100,4*deviation_ms),250,3000);
+	}
+	int credit(int current, int rate, int block, int remote, int local, std::int64_t now) {
+		int const cap=std::max(1,std::min(remote,local));
+		current=std::clamp(current,1,cap);
+		if (!fresh(now) || rate<=0 || block<=0) return current;
+		if (adjusted_ms>=0 && now>=adjusted_ms && now-adjusted_ms<500) return current;
+		adjusted_ms=now;
+		auto const horizon=std::clamp<std::int64_t>(mean_ms+2*deviation_ms+100,250,2000);
+		auto const wanted=std::clamp<std::int64_t>(
+			std::int64_t(rate)*horizon/1000/block+2,1,cap);
+		int const deadband=std::max(2,current/8);
+		if (wanted-current<=deadband && current-wanted<=deadband) return current;
+		int const step=std::max(2,current/4);
+		int const next=int(std::clamp<std::int64_t>(wanted,std::max(1,current-step),std::min(cap,current+step)));
+		if (next!=current) ++budget_changes;
+		return next;
+	}
+private:
+	int fresh_samples=0;
+};
+
+// Both concurrent occupancy and issued-per-second credit are bounded. Shared
+// ownership follows pending_block copies through sends, cancels and teardown.
+struct flow_hedge_budget {
+	flow_hedge_budget(int requests_, int bytes_) : limit_requests(requests_), limit_bytes(bytes_) {}
+	int const limit_requests,limit_bytes;
+	std::atomic<int> active{0}, bytes{0}, peak{0};
+	std::int64_t window_ms=-1;
+	int issued=0, issued_bytes=0;
+	bool acquire(int size,std::int64_t now) {
+		if(size<=0 || size>limit_bytes) return false;
+		if(window_ms<0 || now<window_ms || now-window_ms>=1000) {
+			window_ms=now; issued=0; issued_bytes=0;
+		}
+		if(active.load()>=limit_requests || bytes.load()>limit_bytes-size
+			|| issued>=limit_requests || issued_bytes>limit_bytes-size) return false;
+		int const used=active.fetch_add(1)+1;
+		bytes+=size; ++issued; issued_bytes+=size;
+		int old=peak.load(); while(old<used && !peak.compare_exchange_weak(old,used)) {}
+		return true;
+	}
+	void release(int size) { --active; bytes-=size; }
+};
+struct flow_hedge_credit {
+	std::shared_ptr<flow_hedge_budget> torrent,session;
+	int bytes;
+	flow_hedge_credit(std::shared_ptr<flow_hedge_budget> t,std::shared_ptr<flow_hedge_budget> s,int b)
+		: torrent(std::move(t)),session(std::move(s)),bytes(b) {}
+	~flow_hedge_credit() { torrent->release(bytes); session->release(bytes); }
+	static std::shared_ptr<flow_hedge_credit> acquire(
+		std::shared_ptr<flow_hedge_budget> const& torrent,
+		std::shared_ptr<flow_hedge_budget> const& session,int bytes,std::int64_t now) {
+		if(!torrent->acquire(bytes,now)) return {};
+		if(!session->acquire(bytes,now)) { torrent->release(bytes); return {}; }
+		try { return std::make_shared<flow_hedge_credit>(torrent,session,bytes); }
+		catch(...) { torrent->release(bytes); session->release(bytes); throw; }
+	}
+};
+
+struct flow_stream_observations {
+	explicit flow_stream_observations(std::int64_t start) : created_ms(start) {}
+	std::int64_t created_ms,first_dial_ms=-1,first_connect_ms=-1,first_handshake_ms=-1,first_payload_ms=-1;
+	std::int64_t connect_duration_ms=-1,handshake_duration_ms=-1;
+	std::array<flow_histogram,6> service{};
+	std::uint64_t useful_bytes=0,redundant_bytes=0,obsolete_bytes=0,recovery_requests=0,recovery_suppressed=0;
+	void milestone(std::int64_t& field,std::int64_t now) {
+		if(field<0 && now>=created_ms) field=now-created_ms;
+	}
+};
+}
