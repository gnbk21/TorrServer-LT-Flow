+TORRENT_TEST(flow_queue_pressure_does_not_amplify_slow_peer_credit)
+{
+    using namespace lt::aux;
+    flow_service_model model;
+    for(int i=0;i<32;++i) model.observe(30000,1000+i*100);
+    int credit=512;
+    for(int i=0;i<12;++i) {
+        auto const now=4200+i*500;
+        model.observe(30000,now);
+        int const next=model.credit(credit,65536,16384,512,1500,now,credit);
+        TEST_CHECK(next<=credit);
+        credit=next;
+    }
+    TEST_CHECK(credit<=32);
+    TEST_CHECK(!model.urgent_work_allowed(70000,16,512,true,9700));
+    // The earlier delayed-peer and application-limited regressions continue
+    // to require useful growth and retention within a qualified horizon.
+    flow_service_model delayed;
+    for(int i=0;i<32;++i) delayed.observe(2500,1000+i*100);
+    TEST_CHECK(delayed.credit(2,12000,16384,512,512,4200,2)>2);
+    TEST_CHECK(delayed.urgent_work_allowed(4000,2,4,true,4200));
+    TEST_EQUAL(delayed.credit(428,12000,16384,512,512,4800,0),428);
+}
