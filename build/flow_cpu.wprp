<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="TorrServer-Flow">
  <Profiles>
    <SystemCollector Id="FlowCPUCollector" Name="NT Kernel Logger">
      <BufferSize Value="256" />
      <Buffers Value="256" />
    </SystemCollector>
    <SystemProvider Id="FlowCPUSystem">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="SampledProfile" />
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile" />
      </Stacks>
    </SystemProvider>
    <Profile Id="FlowCPU.Verbose.File" Name="FlowCPU" DetailLevel="Verbose" LoggingMode="File" Description="Disposable synthetic CPU sampling">
      <Collectors>
        <SystemCollectorId Value="FlowCPUCollector">
          <SystemProviderId Value="FlowCPUSystem" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
    <Profile Id="FlowCPU.Verbose.Memory" Name="FlowCPU" Base="FlowCPU.Verbose.File" DetailLevel="Verbose" LoggingMode="Memory" Description="Bounded disposable synthetic CPU sampling" />
  </Profiles>
</WindowsPerformanceRecorder>
