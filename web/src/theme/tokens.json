  "palettes": {
    "iris": {
      "dark": {
        "primary": "#c3c6ff",
        "on-primary": "#252b60",
        "primary-container": "#343b74",
        "on-container": "#e1e2ff"
      },
      "light": {
        "primary": "#4e5598",
        "on-primary": "#ffffff",
        "primary-container": "#e1e2ff",
        "on-container": "#30376d"
      }
    },
    "lagoon": {
      "dark": {
        "primary": "#9bd9d9",
        "on-primary": "#003738",
        "primary-container": "#164e50",
        "on-container": "#b8f0f0"
      },
      "light": {
        "primary": "#00696d",
        "on-primary": "#ffffff",
        "primary-container": "#b2ebed",
        "on-container": "#004f52"
      }
    },
    "rose": {
      "dark": {
        "primary": "#f3b4d0",
        "on-primary": "#521f3a",
        "primary-container": "#6d3552",
        "on-container": "#ffdaea"
