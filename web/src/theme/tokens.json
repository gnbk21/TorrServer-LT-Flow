{
  "shape": {
    "small": "0.75rem",
    "medium": "1.25rem",
    "large": "1.75rem",
    "extra": "2.25rem"
  },
  "motion": {
    "fast": "120ms",
    "standard": "180ms",
    "spatial": "280ms",
    "effects": "cubic-bezier(.2,0,0,1)",
    "spring": "cubic-bezier(.2,.8,.2,1)"
  },
  "schemes": {
    "dark": {
      "bg": "#111219",
      "input": "#171922",
      "surface": "#1c1e28",
