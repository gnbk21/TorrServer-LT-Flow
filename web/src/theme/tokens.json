  "typography": {
    "family": "\"Segoe UI Variable\", \"Segoe UI\", Roboto, system-ui, sans-serif",
    "headline": "clamp(1.75rem, 4vw, 2.75rem)",
    "title": "1.5rem",
    "subtitle": "1.125rem",
    "body": "1rem",
    "label": "0.875rem",
    "line-body": "1.5",
    "line-headline": "1.16",
    "line-title": "1.3",
    "weight-headline": "650",
    "weight-title": "600",
    "weight-label": "550"
