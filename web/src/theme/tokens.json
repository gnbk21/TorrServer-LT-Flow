      "border": "#85879b",
      "muted": "#b4b6c9",
      "secondary": "#ccd0df",
      "text": "#e5e5f2",
      "error": "#ffb4b0",
      "on-error": "#690005",
      "warning": "#f4bf74",
      "success": "#a3d9c7",
      "on-success": "#00382b"
    },
    "light": {
      "bg": "#f6f5fc",
      "input": "#ffffff",
      "surface": "#ffffff",
      "surface-hover": "#e5e4ef",
      "border": "#737487",
      "muted": "#606174",
      "secondary": "#444658",
      "text": "#242533",
      "error": "#a72b30",
      "on-error": "#ffffff",
      "warning": "#79520b",
      "success": "#236750",
      "on-success": "#ffffff"
