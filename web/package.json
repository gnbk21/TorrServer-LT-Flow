{
  "name": "torrserver-flow-web",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/notices.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src && node --test scripts/linter-glob-compat.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:lab": "playwright test --config playwright.lab.config.ts",
    "format": "prettier --write src e2e *.ts *.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@tanstack/react-query": "^5.62.8",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.0",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "ajv": "6.15.0",
    "ajv-formats-draft2019": "1.6.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.3",
    "vitest": "^4.1.12"
  },
  "resolutions": {
    "vite": "8.3.3",
    "source-map-js": "1.2.2",
    "undici": "7.30.1",
    "zod": "4.6.7",
    "**/@typescript-eslint/typescript-estree/minimatch": "11.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
